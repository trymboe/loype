# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://ldqrjypjeikdtkzoqrsn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # publishable/anon key (safe for the browser)
SUPABASE_SERVICE_ROLE_KEY=                # secret! server-only, used by background sync

# --- Access control ---
ALLOWED_EMAIL=                            # who may sign in; several allowed, comma-separated

# --- Secrets ---
TOKEN_ENCRYPTION_KEY=                     # openssl rand -base64 32
CRON_SECRET=                              # openssl rand -hex 32  (Vercel Cron sends it automatically)

# --- Garmin (each user pastes their own Personal API key in the app) ---
# GARMIN_API_BASE_URL=https://personal.connectapi.garmin.com

# Coach. Runs on Claude (Anthropic API) when ANTHROPIC_API_KEY is set; OpenAI is the
# fallback when there's no Anthropic key or a Claude request fails. Without either key
# the Coach tab explains how to add one.
ANTHROPIC_API_KEY=
# COACH_CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# COACH_MODEL=gpt-6-luna                  # OpenAI fallback model

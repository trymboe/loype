# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://ldqrjypjeikdtkzoqrsn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # publishable/anon key (safe for the browser)
SUPABASE_SERVICE_ROLE_KEY=                # secret! server-only, used by background sync

# --- Access control ---
ALLOWED_EMAIL=                            # the only address allowed to sign in

# --- Secrets ---
TOKEN_ENCRYPTION_KEY=                     # openssl rand -base64 32
CRON_SECRET=                              # openssl rand -hex 32  (Vercel Cron sends it automatically)

# --- Garmin (optional: you can paste the key in the app instead) ---
GARMIN_PERSONAL_API_KEY=
# GARMIN_API_BASE_URL=https://personal.connectapi.garmin.com

# Coach (OpenAI API). Without a key the Coach tab explains how to add one.
OPENAI_API_KEY=
# COACH_MODEL=gpt-6.1-luna
